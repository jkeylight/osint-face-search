# OSINT Face Search - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Uploads (user data)
uploads/*
!uploads/.gitkeep

# Cache
cache/*
!cache/.gitkeep

# Database
data/*
!data/.gitkeep

# Logs
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright
playwright-report/
test-results/

# Temporary
*.tmp
*.temp
