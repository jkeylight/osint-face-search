# OSINT Face Search - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime user data (never commit)
uploads/*
!uploads/.gitkeep
cache/*
!cache/.gitkeep
data/*
!data/.gitkeep
logs/

# ML models (downloaded by scripts/download_models.py)
models/

# Generated desktop-icon formats (built from assets/icon.png by setup_desktop)
assets/icon.ico
assets/icon.icns
scripts/desktop_launcher.vbs

# Databases
*.db
*.db-wal
*.db-shm

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright
playwright-report/
test-results/

# Temporary
*.tmp
*.temp
