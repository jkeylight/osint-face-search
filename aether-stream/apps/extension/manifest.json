{
  "manifest_version": 3,
  "name": "AETHER-STREAM Capture",
  "version": "0.1.0",
  "description": "User-invoked, privacy-first media capture bridge for AETHER-STREAM.",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Send visible media to AETHER-STREAM"
  }
}
